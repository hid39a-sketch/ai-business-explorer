# .env にコピーして使う（.env は Git にコミットしない）
APP_ENV=development
DATABASE_URL=postgresql+psycopg://abe:abe@localhost:5432/ai_business_explorer
TEST_DATABASE_URL=postgresql+psycopg://abe:abe@localhost:5432/ai_business_explorer_test

# AI社員の llm_config.provider を省略したときのプロバイダー。fake（既定）/ anthropic（Claude API）
LLM_PROVIDER=fake
# Claude API の API キー（anthropic の AI社員だけが使う）。ここに実際のキーを書いてコミットしないこと。
# 未設定なら anthropic の AI社員は実行できない。APP_ENV=test では使われない
LLM_API_KEY=

# 実行記録に残すコードバージョン（未設定なら git rev-parse HEAD）
# CODE_VERSION=

# ステージ実行の方式。async：API は受け付けて 202 を返し、ワーカー（make worker）が実行する。
# sync：ワーカーなしで、応答の前に実行を終える（Fake LLM での確認用）。
EXECUTION_MODE=async
# タイムアウト（秒）とワーカーの生存確認
STAGE_RUN_TIMEOUT_SECONDS=600
LLM_CALL_TIMEOUT_SECONDS=120
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_HEARTBEAT_TIMEOUT_SECONDS=60

# LLM プロバイダーごとの送信可能なデータ分類の上限（JSON）。指定のないプロバイダーは internal。
# 契約条件を確認するまで internal のままにする。restricted は設定できない（どの LLM にも送らない）
# LLM_MAX_CLASSIFICATION={"fake": "internal"}

# 費用管理（第2回仕様 10章・R-21 の暫定値）。予算の行がない組織はこの月額上限と方式を使う
BUDGET_CURRENCY=USD
ORGANIZATION_MONTHLY_BUDGET=100
ORGANIZATION_BUDGET_MODE=hard
# 1回の実行ごとの上限（AI社員の llm_config で個別に指定できる）
EXECUTION_MAX_COST=1
EXECUTION_MAX_LLM_CALLS=20
EXECUTION_MAX_TOOL_CALLS=20

# LLM ログの本文。full（public・internal を保存。confidential 以上は常に保存しない）または none
LLM_PAYLOAD_MODE=full
LLM_PAYLOAD_RETENTION_DAYS=90
# Tool の生の出力と、Tool で取得した全文（Evidence 候補のスナップショット）の保存期間（R-20）
TOOL_OUTPUT_RETENTION_DAYS=90
TOOL_SNAPSHOT_RETENTION_DAYS=180

# 外部と通信する Tool（第2回仕様 13章）。write は設定しても拒否される
TOOL_ALLOWED_SIDE_EFFECTS=["read_only", "external_read"]
# 組織ごとの Tool の有効化とドメインの許可・禁止リスト（JSON）。未設定なら外部 Tool は使えない
# TOOL_CONFIG_PATH=config/tools.example.json
# Web 取得で送る User-Agent（未設定なら製品名とバージョン）
# WEB_FETCH_USER_AGENT=
